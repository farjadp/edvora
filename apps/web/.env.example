# --- Core ---
DATABASE_URL=postgres://edvora:edvora@localhost:5442/edvora
# openssl rand -hex 32
PAYLOAD_SECRET=change-me
SESSION_SECRET=change-me-too
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Tenant used when the request host doesn't match any tenant domain (local dev).
DEFAULT_TENANT_SLUG=iba
# Staff 2FA (TOTP). true = staff get no permissions until they enrol + verify. Keep false until the
# /staff 2FA screens exist (E-022); people who turned 2FA on are always asked for it.
STAFF_2FA_REQUIRED=false

# --- Providers (mock | real). Mocks need no accounts. ---
PAYMENT_PROVIDER=mock
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true

SMS_PROVIDER=mock
KAVENEGAR_API_KEY=
KAVENEGAR_SENDER=
KAVENEGAR_OTP_TEMPLATE=verify

# --- SMS reminders worker (E-016, ADR 020, docs/runbooks/sms-reminders.md) ---
# Global kill switch. Anything but `true` = the worker sends nothing (the cron call answers {disabled: true}).
# Keep false in production until the SMS contract and keys are in hand. Sandboxes and `demo` always use the mock.
SMS_REMINDERS_ENABLED=false
# Bearer secret for POST /api/cron/reminders (Railway cron). ≥ 24 chars; empty = the route answers 404.
# openssl rand -hex 32
REMINDERS_CRON_SECRET=
# Test-only: lets the cron call pass ?now=<ISO>&tenant=<slug> (e2e). Never true on a public deployment.
REMINDERS_E2E_HOOKS=false

# --- Seed ---
SEED_ADMIN_EMAIL=admin@edvora.local
SEED_ADMIN_PASSWORD=change-me-now
# Demo-tenant staff for E-028 (advisor@demo.edvora.local, finance@demo.edvora.local). Empty = random (no login).
SEED_DEMO_STAFF_PASSWORD=

# --- Private uploads (ADR 009) ---
# Student assignment files. Never under a public/static path. Relative paths resolve from apps/web.
PRIVATE_UPLOADS_DIR=private-uploads/submission-files

# --- Live classes (E-033, ADR 012) ---
# mock = offline classroom page at /live/mock (no server needed). bigbluebutton = a BBB 4.0 server you run.
LIVE_CLASS_PROVIDER=mock
# Signs mock join tickets and mock webhooks. Defaults to a value derived from SESSION_SECRET.
LIVE_CLASS_MOCK_SECRET=
# BigBlueButton: base URL ending in /bigbluebutton/ and the shared secret (`bbb-conf --secret`).
BBB_URL=
BBB_SECRET=
BBB_CHECKSUM=sha256

# --- Object storage (E-017): recordings, and Media when S3_MEDIA=true ---
# mock = in memory (recordings are lost on restart). s3 = ArvanCloud Object Storage in production, e.g.
# S3_ENDPOINT=https://s3.ir-thr-at1.arvanstorage.ir. Locally: SeaweedFS from compose.local.yml at http://localhost:9010
# with S3_ACCESS_KEY_ID=edvora and S3_SECRET_ACCESS_KEY=edvora-local-secret (infra/docker/seaweedfs-s3.json).
# The bucket is created on first upload, or once with: pnpm --filter @edvora/web exec tsx --env-file=.env src/seed/s3-bucket.ts
STORAGE_PROVIDER=mock
S3_ENDPOINT=
S3_BUCKET=edvora
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=default
S3_MEDIA=false

# --- WordPress import (E-032, ADR 011) ---
# Raw bundles / pushed chunks / plan files. Private, never under a public path. Default: private-uploads/import-bundles
IMPORT_BUNDLES_DIR=
# Payload jobs queue for imports. Exactly one app process should run it (set false on the others).
IMPORT_QUEUE_AUTORUN=true
IMPORT_QUEUE_CRON=* * * * *
IMPORT_MAX_BUNDLE_MB=100
# Plugin source served at /staff/import/plugin (default: ../../integrations/wordpress-plugin/edvora-migrator)
WP_PLUGIN_DIR=

# --- Self-serve demo sandboxes (E-029, docs/adr/013-sandbox-tenants.md) ---
# Kill switch: only the literal "true" turns creation on. Off = /demo shows "temporarily unavailable".
SANDBOX_ENABLED=false
# Hosts that serve /demo and honour the sandbox cookie (comma-separated, no port). Empty = host of NEXT_PUBLIC_SITE_URL.
SANDBOX_PLATFORM_HOSTS=
# Lifetime (fixed at creation, no extension) and how long an ended sandbox is kept before hard delete.
SANDBOX_TTL_HOURS=3
SANDBOX_GRACE_HOURS=24
# Capacity and abuse limits (counted in our own DB / process; no external service).
SANDBOX_MAX_ACTIVE=20
SANDBOX_IP_DAILY_MAX=3
SANDBOX_IP_ACTIVE_MAX=1
SANDBOX_REQUESTS_PER_MINUTE=10
# Number of reverse proxies in front of the app that append to X-Forwarded-For (Railway: 1; CDN + Railway: 2).
SANDBOX_TRUSTED_PROXY_HOPS=1
# Proof of work (leading zero bits of sha256) and minimum time between page render and submit.
SANDBOX_POW_BITS=14
SANDBOX_MIN_FILL_MS=3000
SANDBOX_CHALLENGE_TTL_MINUTES=15
# Total uploads per sandbox (media + submission files), in MB.
SANDBOX_UPLOAD_MB=5
# Bearer secret for POST /demo/api/cleanup (cron) and the e2e hook. ≥ 24 chars; empty = both routes answer 404.
# openssl rand -hex 32
SANDBOX_CRON_SECRET=
# TODO(client): contact link for "talk to us" (WhatsApp/Telegram/phone/email). Empty = an email form with consent.
SANDBOX_CONTACT_URL=
# Test-only: enables POST /demo/api/test/expire (needs SANDBOX_CRON_SECRET). Never true on a public deployment.
SANDBOX_E2E_HOOKS=false

# --- Payment methods (E-045, ADR 017) ---
# Seals gateway credentials stored per academy. Empty = derived from PAYLOAD_SECRET. Set a dedicated value in production.
PAYMENT_SECRETS_KEY=
# Card-to-card receipt images. Never under a public path.
PAYMENT_RECEIPTS_DIR=private-uploads/payment-receipts
# USDT verification: mock (default with PAYMENT_PROVIDER=mock) | live. Keys only for live.
CHAIN_VERIFIER=
TRONGRID_API_KEY=
BSC_API_KEY=
USDT_TRC20_TESTNET_CONTRACT=
USDT_BEP20_TESTNET_CONTRACT=

# --- AI assistant (E-046, ADR 018) ---
# Provider, model and key are set per academy in /staff/assistant/settings (keys sealed in the database).
# Seals those keys (AES-256-GCM). Set a dedicated value in production: openssl rand -hex 32. Empty = derived from PAYLOAD_SECRET.
AI_SECRETS_KEY=
# mock = every academy uses the offline mock provider (CI, e2e, local dev). Empty in production.
AI_PROVIDER_OVERRIDE=mock

# E-047 (ADR 019): key for academy integration secrets (SMS/SMTP/BBB keys entered in /admin/settings).
# Optional; falls back to PAYLOAD_SECRET. Set a dedicated value in production. Rotating it makes stored keys unreadable.
SETTINGS_SECRETS_KEY=
