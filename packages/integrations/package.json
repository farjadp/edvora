{
  "name": "@edvora/integrations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Adapters for outside services (payment, SMS, video, live, AI). Every adapter has a mock.",
  "exports": {
    ".": "./src/index.ts",
    "./payment": "./src/payment/index.ts",
    "./sms": "./src/sms/index.ts",
    "./live-class": "./src/live-class/index.ts",
    "./storage": "./src/storage/index.ts",
    "./wordpress": "./src/wordpress/index.ts",
    "./connection": "./src/connection/index.ts",
    "./ai": "./src/ai/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@aws-sdk/client-s3": "^3.1164.0",
    "@aws-sdk/lib-storage": "^3.1164.0",
    "@aws-sdk/s3-request-presigner": "^3.1164.0",
    "@edvora/core": "workspace:*",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@edvora/config": "workspace:*",
    "@types/node": "^24.10.0",
    "typescript": "5.9.3",
    "vitest": "^4.0.18"
  }
}
