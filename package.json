{
  "name": "edvora",
  "private": true,
  "description": "Edvora — AshaVid's white-label Academy & Learning Business Platform",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@edvora/web",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "seed": "pnpm --filter @edvora/web seed",
    "db:up": "docker compose -f infra/docker/compose.local.yml up -d",
    "db:down": "docker compose -f infra/docker/compose.local.yml down"
  },
  "devDependencies": {
    "turbo": "^2.11.10",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
